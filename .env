# E-Commerce Frontend Environment Configuration
# Restart the dev server after changing these values.

# Data mode: "mock" or "api"
# mock = works without backend, uses simulated data
# api  = requires Spring Boot backend running
REACT_APP_DATA_MODE=mock

# Backend API base URL (used in api mode)
REACT_APP_API_BASE_URL=http://localhost:5454

# Prevent CI environments (like Vercel) from failing builds on minor ESLint warnings
CI=false
