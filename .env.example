# E-Commerce Frontend Environment Configuration
# Copy this file to .env and adjust values as needed.
# Restart the dev server after changing these values.

# Data mode: "mock" or "api"
# mock = works without backend, uses simulated data stored in localStorage
# api  = requires Spring Boot backend running at the URL below
REACT_APP_DATA_MODE=mock

# Backend API base URL (used only in api mode)
REACT_APP_API_BASE_URL=http://localhost:5454
